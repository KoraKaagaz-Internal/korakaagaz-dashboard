# Supabase project (Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only: used by the daily cron job (keep secret)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public URL of the app (links in emails, PDF rendering)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Protects /api/cron/daily (any long random string)
CRON_SECRET=change-me

# Gmail sending as team@korakaagaz.co (Google account -> Security -> App passwords).
# Without SMTP_PASS emails are logged as "skipped".
SMTP_USER=team@korakaagaz.co
SMTP_PASS=
